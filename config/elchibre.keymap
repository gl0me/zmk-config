#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        L0 {
            // --------------------------------------------------------------------
            // |  '  |  ,  |  .  |  P  |  Y  |     |  F  |  G   |  C  |  R  |  L  |
            // |  A  |  O  |  E  |  U  |  I  |     |  D  |  H   |  T  |  N  |  S  |
            // |  ;  |  Q  |  J  |  K  |  X  |     |  B  |  M   |  W  |  V  |  Z  |
            //             |CTRL | BCK | ENT |     | SPC |  L1  | SHFT|
            // --------------------------------------------------------------------
            bindings = <
              &kp APOS          &mt QUESTION COMMA  &mt EXCLAMATION DOT  &kp P             &kp Y        &kp F      &kp G              &kp C                &kp R            &kp L            
              &mt LEFT_WIN A    &mt LEFT_ALT O      &mt LCTRL E          &mt LEFT_SHIFT U  &kp I        &kp D      &mt RIGHT_SHIFT H  &mt RIGHT_CONTROL T  &mt RIGHT_ALT N  &mt RIGHT_WIN S  
              &kp SEMI          &kp Q               &kp J                &kp K             &kp X        &kp B      &kp M              &kp W                &kp V            &kp Z           
              &sk LEFT_CONTROL  &kp BACKSPACE       &kp ENTER            &kp SPACE         &to 1        &sk RIGHT_SHIFT
            >;
        };

        L1 {
            bindings = <
              &kp ESCAPE        &kp AT        &kp HASH          &kp DOLLAR     &kp PERCENT         &kp CARET               &kp AMPS              &kp ASTRK              &kp SEMI               &kp BACKSPACE  
              &kp TAB           &kp KP_EQUAL  &kp K_CUT         &kp DEL        &kp SINGLE_QUOTE    &mt BACKSLASH KP_SLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE               &kp ENTER      
              &kp GRAVE         &kp LEFT_WIN  &kp K_COPY        &kp K_PASTE    &kp DQT             &mt HOME LEFT_BRACKET   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mt END RIGHT_BRACKET  &to 2         
              &sk LEFT_CONTROL  &to 0         &kp LWIN          &kp RIGHT_ALT  &to 3               &sk RIGHT_SHIFT
            >;
        };

        L2 {
            bindings = <
              &mt LC(LA(DELETE)) ESCAPE  &msc SCRL_LEFT  &mmv MOVE_UP      &msc SCRL_RIGHT  &mkp MCLK       &kp RA(LEFT_ARROW)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp RA(RIGHT)  &kp BACKSPACE 
              &kp TAB                    &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_RIGHT  &kp DEL         &kp LEFT            &kp DOWN         &kp UP       &kp RIGHT      &kp ENTER      
              &trans                     &trans          &msc SCRL_UP      &msc SCRL_DOWN   &mkp LCLK       &mkp RCLK           &trans           &trans       &trans         &to 4          
              &sk LEFT_CONTROL           &to 0           &kp LEFT_WIN      &kp RIGHT_ALT    &to 1           &sk RSHIFT
            >;
        };

        L3 {
            bindings = <
              &kp ESCAPE        &kp C_PREV            &kp C_NEXT            &kp C_PLAY_PAUSE  &kp KP_MINUS    &kp UNDERSCORE   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE 
              &kp TAB           &kp C_VOL_DN          &kp C_VOLUME_UP       &kp KP_MULTIPLY   &kp KP_PLUS     &kp EQUAL        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ENTER     
              &kp C_RESET       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp KP_DIVIDE     &kp KP_DOT      &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &to 2         
              &sk LEFT_CONTROL  &to 0                 &kp LEFT_WIN          &kp RIGHT_ALT     &to 1           &sk RSHIFT
            >;
        };

        L4 {
            bindings = <
              &bt BT_CLR_ALL  &trans  &trans  &trans  &trans    &trans      &trans      &trans  &trans  &trans
              &trans          &trans  &trans  &trans  &trans    &bt BT_PRV  &bt BT_NXT  &trans  &trans  &trans
              &trans          &trans  &trans  &trans  &trans    &trans      &trans      &trans  &trans  &trans
              &trans          &to 0   &trans  &trans  &to 1     &trans
            >;
        };
    };
};
